# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
Dockerfile.cross

# Do ignore things like bin/k8s/
bin/*/
bin/manager

# Do not ignore hermit binary and pkg files in bin/
!bin/hermit
!bin/.hermit/
!bin/*.pkg
!bin/.*pkg

# Output from go build / go run
*.out

# Go vendor directory (if vendoring dependencies)
vendor/

# Go test output
*.test
*.cover
*.prof

# Go workspace file
go.work
go.work.sum

# Kubernetes Generated files - skip generated files, except for vendored files
!vendor/**/zz_generated.*

# IDEs and editors
.vscode/
.idea/
*.sw?
*.swo
*.swp

# OS-specific files
.DS_Store
Thumbs.db

# Kubernetes config/testing
.kube/
config/crd/bases/*_edited.yaml

# Kubebuilder cache files and build artifacts
testbin/
controller-gen

# Generated CRDs and deep copy files (can be re-generated)
zz_generated.*

# Cache for controller runtime/envtest
testenv/

# Env files
.env
.envrc

# crd test data
test/data/
